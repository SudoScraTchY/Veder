@page "/"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>Veder · weather and air quality</PageTitle>

@*
  Screen 1 of the design brief: search and first result. Deliberately not a marketing page — the first
  thing a visitor can do is ask a question. Whitespace carries the hierarchy; a single accent (ochre)
  marks the one action on the screen.
*@
<main class="mx-auto max-w-2xl px-6 py-20">
    <header class="mb-12">
        <p class="font-mono text-xs uppercase tracking-[0.18em] text-sage-700">Veder</p>
        <h1 class="mt-3 text-4xl font-semibold leading-tight text-ink-900">
            Weather and air quality, without an account.
        </h1>
        <p class="mt-4 text-lg text-ink-500">
            Enter a place. You will get current conditions, the outlook and air quality — and the chip that
            tells you which source produced each number.
        </p>
    </header>

    <form class="flex flex-wrap items-end gap-3" @onsubmit="Submit" @onsubmit:preventDefault>
        <label class="flex min-w-[16rem] flex-1 flex-col gap-1.5">
            <span class="font-mono text-xs uppercase tracking-wide text-ink-500">Place</span>
            <input class="rounded-lg border border-parchment-300 bg-parchment-50 px-4 py-3 text-lg text-ink-900 outline-none placeholder:text-ink-500/60 focus:border-sage-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ochre-700"
                   placeholder="Tehran, Berlin, Osaka…"
                   aria-label="Place name"
                   @bind="_place"
                   @bind:event="oninput" />
        </label>

        <button type="submit"
                class="rounded-lg bg-ochre-500 px-6 py-3 font-medium text-parchment-50 hover:bg-ochre-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ochre-700">
            Show weather
        </button>
    </form>

    <p class="mt-3 text-sm text-ink-500">
        Or go straight to a coordinate:
        <button type="button" class="text-ochre-700 underline hover:text-ochre-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ochre-700"
                @onclick="GoToCoordinate">
            Tehran (35.689, 51.389)
        </button>
    </p>

    <section class="mt-16 border-t border-parchment-300 pt-8">
        <h2 class="font-mono text-xs uppercase tracking-wide text-ink-500">Or a common starting point</h2>
        <div class="mt-4 flex flex-wrap gap-2">
            @foreach (var place in QuickPlaces)
            {
                <button type="button"
                        class="rounded-full border border-parchment-300 px-4 py-1.5 text-sm text-ink-700 hover:border-ochre-500 hover:text-ochre-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ochre-700"
                        @onclick="() => GoTo(place)">
                    @place
                </button>
            }
        </div>
    </section>
</main>

@code {
    private static readonly string[] QuickPlaces = ["Berlin", "London", "Tehran", "Tokyo", "New York"];

    private string _place = string.Empty;

    private void GoToCoordinate() => Navigation.NavigateTo("/weather?lat=35.6892&lon=51.389");

    private void Submit() => GoTo(string.IsNullOrWhiteSpace(_place) ? "Tehran" : _place.Trim());

    private void GoTo(string place) => Navigation.NavigateTo($"/weather?name={Uri.EscapeDataString(place)}");
}
