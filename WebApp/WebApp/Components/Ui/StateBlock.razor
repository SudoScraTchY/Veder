@*
  One presentation for the three states a data view can be in, so no screen invents its own.
  Loading reserves height so nothing jumps; empty and error are written copy, never a blank region.
*@
@if (State == StateBlockState.Loading)
{
    <div class="animate-pulse space-y-3" aria-busy="true" aria-live="polite">
        <div class="h-4 w-1/3 rounded bg-parchment-200"></div>
        <div class="h-3 w-2/3 rounded bg-parchment-200"></div>
        <div class="h-3 w-1/2 rounded bg-parchment-200"></div>
    </div>
}
else if (State == StateBlockState.Empty)
{
    <div class="rounded-card border border-parchment-300 bg-parchment-100 px-5 py-8 text-center" role="status">
        <p class="text-ink-700">@EmptyMessage</p>
        @if (!string.IsNullOrWhiteSpace(Hint))
        {
            <p class="mt-1 text-sm text-ink-500">@Hint</p>
        }
    </div>
}
else if (State == StateBlockState.Error)
{
    <div class="rounded-card border border-terracotta-500 bg-parchment-100 px-5 py-6" role="alert">
        <p class="font-medium text-terracotta-700">@ErrorMessage</p>
        @if (!string.IsNullOrWhiteSpace(Hint))
        {
            <p class="mt-1 text-sm text-ink-700">@Hint</p>
        }
        @if (OnRetry.HasDelegate)
        {
            <button type="button"
                    class="mt-4 rounded-lg border border-ochre-500 px-4 py-1.5 text-sm text-ochre-700 hover:bg-ochre-300/30 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ochre-700"
                    @onclick="OnRetry">
                Try again
            </button>
        }
    </div>
}

@code {
    public enum StateBlockState { Loading, Empty, Error, Ready }

    [Parameter] public StateBlockState State { get; set; } = StateBlockState.Ready;

    [Parameter] public string EmptyMessage { get; set; } = "Nothing to show yet.";

    [Parameter] public string ErrorMessage { get; set; } = "Something went wrong.";

    [Parameter] public string? Hint { get; set; }

    [Parameter] public EventCallback OnRetry { get; set; }
}
